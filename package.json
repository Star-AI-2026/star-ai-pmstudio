{
  "name": "star-ai-desktop",
  "version": "2.202.0",
  "description": "Star-AI Windows desktop - 2.202.0",
  "main": "src/main.js",
  "author": "PM Studio",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build:x64": "electron-builder --win --x64 --config.directories.output=release/x64",
    "build:x86": "electron-builder --win --ia32 --config.directories.output=release/x86",
    "build:all": "npm run build:x64 && npm run build:x86",
    "dist": "npm run build:all",
    "release": "node release.cjs",
    "test:local-app": "node --test tests/local-app.test.cjs"
  },
  "devDependencies": {
    "electron": "^38.1.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.pmstudio.starai",
    "productName": "Star-AI",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "icon": "build/icon.ico",
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "portable"
      ]
    },
    "portable": {
      "artifactName": "Star-AI-${version}-${arch}.exe"
    },
    "extraResources": [
      {
        "from": "web",
        "to": "web"
      }
    ]
  }
}
